{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["frozen_commit", "model", "run_ids", "planned_cases", "scored_cases", "attempts", "aggregate", "cases", "cost_usd", "failures", "artifacts"],
  "properties": {
    "frozen_commit": {"type": "string"}, "model": {"type": "string"},
    "run_ids": {"type": "array", "items": {"type": "string"}},
    "planned_cases": {"type": "integer", "minimum": 1},
    "scored_cases": {"type": "integer", "minimum": 0},
    "attempts": {"type": "integer", "minimum": 0},
    "aggregate": {"type": "object", "required": ["tp", "fp", "fn", "precision", "recall", "f1", "quote_provenance_accuracy", "source_attribution_accuracy"], "properties": {
      "tp":{"type":"integer"},"fp":{"type":"integer"},"fn":{"type":"integer"},
      "precision":{"type":"number"},"recall":{"type":"number"},"f1":{"type":"number"},
      "quote_provenance_accuracy":{"type":"number"},"source_attribution_accuracy":{"type":["number","null"]}
    }},
    "cases": {"type":"array", "items":{"type":"object","required":["id","status"],"properties":{"id":{"type":"string"},"status":{"type":"string"},"f1":{"type":["number","null"]},"precision":{"type":["number","null"]},"recall":{"type":["number","null"]}}}},
    "cost_usd":{"type":["number","null"]},
    "failures":{"type":"array","items":{"type":"object","required":["case_id","stage","description"]}},
    "artifacts":{"type":"array","items":{"type":"string"}},
    "demo_url":{"type":"string"},"deployment_verified":{"type":"boolean"},
    "benchmark_approved":{"const":true}
  }
}
