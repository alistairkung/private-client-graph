FROM node:24-alpine AS frontend
WORKDIR /build/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build:research

FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim
WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock README.md ./
COPY private_client_graph/ ./private_client_graph/
COPY alembic.ini ./
COPY migrations/ ./migrations/
COPY research/history/ ./research/history/
COPY research/fixtures/ ./research/fixtures/
COPY cases/ ./cases/
RUN uv sync --locked --no-dev
COPY --from=frontend /build/web/research-dist/ ./web/research-dist/
EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && python -m private_client_graph.workbench.bootstrap && exec uvicorn ${PCG_RESEARCH_APP:-private_client_graph.workbench.execution_api:app} --host 0.0.0.0 --port 8000"]
